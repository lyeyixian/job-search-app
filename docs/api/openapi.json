{
  "openapi": "3.1.0",
  "info": {
    "title": "Job search API",
    "version": "0.1.0",
    "description": "A REST API over the vault. Each error is an RFC 9457 Problem Details response with a `code`."
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "vault": {
            "type": "object",
            "properties": {
              "notes": {
                "type": "integer",
                "description": "The count of notes in the vault index.",
                "example": 12
              },
              "loadedAt": {
                "type": "string",
                "format": "date-time",
                "description": "The time that the API built the vault index.",
                "example": "2026-11-14T08:47:10.000Z"
              }
            },
            "required": [
              "notes",
              "loadedAt"
            ]
          }
        },
        "required": [
          "status",
          "vault"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://github.com/lyeyixian/job-search-app/blob/main/docs/architecture/errors-and-logging.md#index_not_ready"
          },
          "title": {
            "type": "string",
            "example": "Index not ready"
          },
          "status": {
            "type": "integer",
            "example": 503
          },
          "detail": {
            "type": "string",
            "example": "The API has no vault index yet."
          },
          "code": {
            "type": "string",
            "description": "A stable name for the error. Clients decide what to do from this field.",
            "example": "index_not_ready"
          },
          "traceId": {
            "type": "string",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "traceId"
        ],
        "description": "An RFC 9457 Problem Details object with a `code`."
      },
      "ApplicationList": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationSummary"
            },
            "description": "The applications that match the query. The order is `strong-fit`, `good-fit`, `stretch`, `skip`, then no verdict. With the same verdict, the newest application is first."
          },
          "choices": {
            "type": "object",
            "properties": {
              "companies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "sg",
                    "remote"
                  ]
                }
              },
              "verdicts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "strong-fit",
                    "good-fit",
                    "stretch",
                    "skip"
                  ]
                }
              },
              "directions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "aligned",
                    "caution",
                    "conflict"
                  ]
                }
              }
            },
            "required": [
              "companies",
              "regions",
              "verdicts",
              "directions"
            ],
            "description": "The values that at least one application has. The query does not change them."
          }
        },
        "required": [
          "applications",
          "choices"
        ]
      },
      "ApplicationSummary": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "The name of the application's folder.",
            "example": "example-co-backend-engineer"
          },
          "company": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` also if the field has a warning.",
            "example": "Example Co"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` also if the field has a warning.",
            "example": "Backend Engineer"
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "sg",
              "remote",
              null
            ],
            "description": "`null` also if the field has a warning."
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "analyzed",
              "applied",
              "interviewing",
              "offer",
              "accepted",
              "rejected",
              "dropped",
              null
            ],
            "description": "`null` also if the field has a warning."
          },
          "captured": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "The day that the application was made. `null` also if the field has a warning.",
            "example": "2026-10-05"
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "strong-fit",
              "good-fit",
              "stretch",
              "skip",
              null
            ],
            "description": "`null` before the first fit analysis. `null` also if the field has a warning."
          },
          "direction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "aligned",
              "caution",
              "conflict",
              null
            ],
            "description": "The direction check. `null` before the first fit analysis. `null` also if the field has a warning."
          },
          "hasResume": {
            "type": "boolean",
            "description": "True if the application has a tailored resume PDF."
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "required": [
          "slug",
          "company",
          "title",
          "region",
          "status",
          "captured",
          "verdict",
          "direction",
          "hasResume",
          "warnings"
        ]
      },
      "Warning": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The frontmatter key.",
            "example": "verdict"
          },
          "problem": {
            "type": "string",
            "enum": [
              "missing",
              "invalid"
            ],
            "description": "`missing` if the note does not have the key. `invalid` if the vault's rules do not permit the value."
          }
        },
        "required": [
          "field",
          "problem"
        ],
        "description": "A field of a note that breaks the vault's rules."
      },
      "Application": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApplicationSummary"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri",
                "description": "The posting on the job board. `null` also if the field has a warning.",
                "example": "https://example.com/careers/1001"
              },
              "analyzed": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "The day of the last fit analysis. `null` also if the field has a warning.",
                "example": "2026-10-05"
              },
              "listing": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "company": {
                    "type": "string",
                    "example": "example-co"
                  },
                  "slug": {
                    "type": "string",
                    "example": "backend-engineer-1001"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "`null` if the vault has no such listing."
                  }
                },
                "required": [
                  "company",
                  "slug",
                  "title"
                ],
                "description": "The listing that the application came from."
              },
              "posting": {
                "type": "string",
                "description": "The posting, without the fit analysis. Markdown."
              },
              "fit": {
                "$ref": "#/components/schemas/FitAnalysis"
              }
            },
            "required": [
              "url",
              "analyzed",
              "listing",
              "posting",
              "fit"
            ]
          }
        ]
      },
      "FitAnalysis": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "verdict": {
            "type": "string",
            "description": "The reasons for the verdict. Markdown."
          },
          "direction": {
            "type": "string",
            "description": "The reasons for the direction check. Markdown."
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Requirement"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gap"
            }
          },
          "gapsNote": {
            "type": "string",
            "description": "The text of the gaps part that is not a gap. Markdown.",
            "example": "No gaps."
          }
        },
        "required": [
          "verdict",
          "direction",
          "requirements",
          "gaps",
          "gapsNote"
        ],
        "description": "`null` if the note has no fit analysis."
      },
      "Requirement": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "description": "Markdown."
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "must-have",
              "nice-to-have",
              null
            ]
          },
          "kindNote": {
            "type": [
              "string",
              "null"
            ],
            "description": "The rest of the kind cell, if it has more text."
          },
          "firmness": {
            "type": "string",
            "description": "Markdown.",
            "example": "likely-flexible: a years number"
          },
          "grade": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "met",
              "partial",
              "gap",
              null
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidencePart"
            }
          }
        },
        "required": [
          "requirement",
          "kind",
          "kindNote",
          "firmness",
          "grade",
          "evidence"
        ]
      },
      "EvidencePart": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/EvidenceText"
          },
          {
            "$ref": "#/components/schemas/EvidenceAchievement"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/EvidenceText",
            "achievement": "#/components/schemas/EvidenceAchievement"
          }
        },
        "description": "A piece of an evidence cell: text, or a reference to an achievement."
      },
      "EvidenceText": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      },
      "EvidenceAchievement": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "achievement"
            ]
          },
          "ref": {
            "type": "string",
            "description": "The reference as the fit analysis writes it.",
            "example": "northwind-software-engineer#cut-build-time"
          },
          "slug": {
            "type": "string",
            "example": "northwind-software-engineer"
          },
          "anchor": {
            "type": "string",
            "example": "cut-build-time"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "roles",
              "projects",
              null
            ],
            "description": "The kind of the note. `null` if no role note or project note has the slug."
          },
          "noteTitle": {
            "type": [
              "string",
              "null"
            ],
            "example": "Software Engineer, Northwind Traders"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "The heading of the achievement. `null` if the note has no such achievement.",
            "example": "Cut build time"
          }
        },
        "required": [
          "type",
          "ref",
          "slug",
          "anchor",
          "note",
          "noteTitle",
          "title"
        ]
      },
      "Gap": {
        "type": "object",
        "properties": {
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "must-have",
              "nice-to-have",
              null
            ],
            "description": "The group that lists the gap."
          },
          "requirement": {
            "type": [
              "string",
              "null"
            ],
            "description": "Markdown."
          },
          "grade": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "met",
              "partial",
              "gap",
              null
            ]
          },
          "action": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "positioning",
              "learning",
              null
            ],
            "description": "The bridging action."
          },
          "text": {
            "type": "string",
            "description": "What to do. Markdown."
          }
        },
        "required": [
          "kind",
          "requirement",
          "grade",
          "action",
          "text"
        ]
      },
      "ExperienceNote": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "roles",
              "projects"
            ]
          },
          "slug": {
            "type": "string",
            "description": "The file name without `.md`.",
            "example": "northwind-software-engineer"
          },
          "title": {
            "type": "string",
            "example": "Software Engineer, Northwind Traders"
          },
          "body": {
            "type": "string",
            "description": "The note without its title. Markdown."
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "description": "The name that a reference uses after `#`.",
                  "example": "cut-build-time"
                },
                "title": {
                  "type": "string",
                  "description": "The `###` heading.",
                  "example": "Cut build time"
                }
              },
              "required": [
                "anchor",
                "title"
              ]
            },
            "description": "The achievements of the note, in the order of the note."
          }
        },
        "required": [
          "kind",
          "slug",
          "title",
          "body",
          "achievements"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check that the API answers and has a vault index",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "The API has a vault index.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The API has no vault index yet. Code `index_not_ready`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications": {
      "get": {
        "operationId": "getApplications",
        "summary": "List the applications, best fit first",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Only applications of this company.",
              "example": "Example Co"
            },
            "required": false,
            "description": "Only applications of this company.",
            "name": "company",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Only applications in this region.",
              "example": "sg"
            },
            "required": false,
            "description": "Only applications in this region.",
            "name": "region",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Only applications with this verdict.",
              "example": "good-fit"
            },
            "required": false,
            "description": "Only applications with this verdict.",
            "name": "verdict",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Only applications with this direction check.",
              "example": "aligned"
            },
            "required": false,
            "description": "Only applications with this direction check.",
            "name": "direction",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The applications that match every query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationList"
                }
              }
            }
          },
          "503": {
            "description": "The API has no vault index yet. Code `index_not_ready`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/{slug}": {
      "get": {
        "operationId": "getApplication",
        "summary": "Get one application with its posting and its fit analysis",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The name of the application's folder.",
              "example": "example-co-backend-engineer"
            },
            "required": true,
            "description": "The name of the application's folder.",
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "404": {
            "description": "No application has the slug. Code `note_not_found`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The API has no vault index yet. Code `index_not_ready`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/{slug}/resume.pdf": {
      "get": {
        "operationId": "getApplicationResume",
        "summary": "Get the tailored resume PDF of an application",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The name of the application's folder.",
              "example": "example-co-backend-engineer"
            },
            "required": true,
            "description": "The name of the application's folder.",
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The PDF file as the vault holds it.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Code `note_not_found` if no application has the slug. Code `resume_not_found` if the application has no resume.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The API has no vault index yet. Code `index_not_ready`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/experience/{kind}/{slug}": {
      "get": {
        "operationId": "getExperienceNote",
        "summary": "Get a role note or a project note",
        "tags": [
          "Experience"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "roles",
                "projects"
              ]
            },
            "required": true,
            "name": "kind",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "example": "northwind-software-engineer"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The note.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceNote"
                }
              }
            }
          },
          "404": {
            "description": "No note of that kind has the slug. Code `note_not_found`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The API has no vault index yet. Code `index_not_ready`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
