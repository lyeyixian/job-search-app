{
  "name": "job-search-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "test": "pnpm --filter @job-search/api test",
    "e2e": "pnpm --filter @job-search/web e2e",
    "openapi": "pnpm --filter @job-search/api openapi && pnpm --filter @job-search/web openapi",
    "lint": "biome check . && pnpm --filter \"./apps/*\" typecheck",
    "format": "biome check --write .",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "mermaid": "^12.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
